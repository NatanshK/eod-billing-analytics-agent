# Copy to .env and fill in, or export these in your shell.

# --- storage -----------------------------------------------------------
# ":memory:" keeps everything in RAM (used by the tests and by ephemeral
# hosts). Point it at a file to persist: DB_PATH=./data/billing.sqlite3
DB_PATH=:memory:

# Load backend/seed_data/*.json on startup when the store is empty.
SEED_ON_STARTUP=true
# Which clinic an empty seed file belongs to (it has no rows to say).
SEED_CLINIC_ID=CLN-KNP-014

# --- narrative layer ---------------------------------------------------
# Leave OPENROUTER_API_KEY unset to run entirely offline: the API still
# returns a fully grounded summary, marked source="fallback".
OPENROUTER_API_KEY=
# A ":free" model costs nothing on OpenRouter's free tier (20 req/min,
# 50 req/day; 1000/day once any credit has been purchased). Narratives are
# cached per data-hash, so a demo spends only a handful of calls.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=2000
# "none" disables reasoning: this task has nothing to think about, and on a
# hybrid model the thinking tokens would eat the answer's budget.
LLM_REASONING_EFFORT=none

# --- http --------------------------------------------------------------
# Comma-separated CORS origins, or "*" to allow any.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=5242880
